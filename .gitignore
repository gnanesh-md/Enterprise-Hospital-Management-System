# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Old reference-project zip snapshots -- historical clutter, not this
# project's source; too large to belong in a public repo's permanent history.
/archive/zips/

# Raw Postgres data files from the torn-down local dev cluster -- binary DB
# files must never be committed.
/archive/legacy-er-backend/.pgdata/
/pgdata/

# Symlink to the backend project, target is a machine-local absolute path
# (not portable across clones/machines).
/hospital-backend
/scratch/

